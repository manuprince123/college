# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =====================================================
# SERVER CONFIG
# =====================================================
PORT=5000
NODE_ENV=development

# =====================================================
# DATABASE (MySQL / AWS RDS)
# =====================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=college_db
DB_PORT=3306
# Set to 'true' for AWS RDS with SSL
DB_SSL=false

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Use a long random string - CHANGE THIS IN PRODUCTION!
JWT_SECRET=change_this_to_a_very_long_random_secret_key_min_32_chars
JWT_EXPIRES=7d

# =====================================================
# AI FEATURES (OpenAI)
# =====================================================
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# =====================================================
# GOOGLE MAPS API
# =====================================================
# Get at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# =====================================================
# AWS S3 (File Storage)
# =====================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=college-management-files

# =====================================================
# EMAIL (SMTP - for notifications)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL=noreply@college.edu
FROM_NAME=Government College

# =====================================================
# FRONTEND URL (for CORS)
# =====================================================
CLIENT_URL=http://localhost:3000

# =====================================================
# RATE LIMITING (optional)
# =====================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
